# =============================================================================
# .env.example - Salin jadi `.env`, lalu isi sesuai environment Anda.
#   cp .env.example .env
#
# `.env` di-gitignore (berisi kredensial). JANGAN commit.
# Semua nilai di sini bisa ditimpa sementara lewat env var saat menjalankan:
#   APP_PORT=8080 ./release.sh my-app v1.0.0
# =============================================================================

# ---------- Umum ----------
REGION=asia-southeast2
# Port yang di-listen container aplikasi
APP_PORT=5000

# ---------- Project tooling (tempat pipeline Cloud Deploy didaftarkan) ----------
TOOLING_PROJECT=edm-bribrain-dev-01

# ---------- Artifact Registry (tujuan mirror image) ----------
AR_HOST=asia-southeast2-docker.pkg.dev
# Project AR terpisah dari TOOLING_PROJECT. Kosongkan untuk ikut TOOLING_PROJECT.
AR_PROJECT=common-cicd-dev-01
AR_REPO=gc-bribrain-dev-gar-temp-01

# ---------- Nexus (sumber image, hasil CI on-prem) ----------
NEXUS_HOST=new-nexus.gcp.bri.co.id
NEXUS_PATH=bribrain/dev
# Kredensial diambil dari Vault — lihat VAULT_NEXUS_PATH di bawah.
# Dua baris berikut hanya cadangan untuk runner tanpa akses Vault; biarkan
# kosong bila Vault dipakai (atau bila runner sudah `crane auth login` sekali).
NEXUS_USER=
NEXUS_PASS=

# ---------- Vault on-prem (sumber secret aplikasi) ----------
# Kosongkan VAULT_ADDR untuk menonaktifkan — Secret akan dirender kosong.
VAULT_ADDR=https://vault.ddb.bri.co.id
VAULT_MOUNT=bribrain
VAULT_ENV=development
# Path default: <VAULT_MOUNT>/data/<VAULT_ENV>/<app-name>
# Isi hanya bila path di Vault tidak mengikuti nama app, mis:
# VAULT_SECRET_PATH=bribrain/data/development/ms-bribrain-demo-apps
VAULT_SECRET_PATH=

# --- Kredensial Nexus di Vault ---
# Kosongkan untuk memakai NEXUS_USER/NEXUS_PASS di atas.
VAULT_NEXUS_PATH=bribrain/data/development/ms-bribrain-demo-apps
# Key di dalam secret itu bernama NEXUS_USER & NEXUS_PASS — sama dengan nama
# variabel di atas, jadi tidak perlu diatur. Uncomment hanya bila suatu saat
# ada path Vault yang memakai nama key berbeda.
# VAULT_NEXUS_USER_KEY=NEXUS_USER
# VAULT_NEXUS_PASS_KEY=NEXUS_PASS

# Kredensial Nexus di atas SELALU disaring dari Secret yang dikirim ke pod —
# ia milik runner, bukan aplikasi. Tambahkan key lain yang juga harus disaring
# (dipisah koma) bila ada nilai non-aplikasi lain di path yang sama:
# VAULT_SECRET_EXCLUDE_KEYS=DOCKER_TOKEN,GIT_PAT
VAULT_SECRET_EXCLUDE_KEYS=

# VAULT_TOKEN SENGAJA TIDAK ADA DI SINI.
# Suplai lewat secret variable CI agar tidak pernah menyentuh disk runner:
#   export VAULT_TOKEN=...

# ---------- Target cluster: dev (WAJIB diisi) ----------
# Diurai dari context kubeconfig:
#   gke_ddb-kubecluster-dev-01_asia-southeast2_gc-ddb-dev-gke-cluster-01
#       └─ DEV_PROJECT ──────┘ └─ REGION ───┘ └─ DEV_CLUSTER ─────────┘
DEV_PROJECT=ddb-kubecluster-dev-01
DEV_CLUSTER=gc-ddb-dev-gke-cluster-01

# ---------- Target cluster: staging (isi saat staging diaktifkan) ----------
STAGING_PROJECT=edm-bribrain-staging-01
STAGING_CLUSTER=

# ---------- Target cluster: prod (isi saat prod diaktifkan) ----------
PROD_PROJECT=edm-bribrain-prod-01
PROD_CLUSTER=

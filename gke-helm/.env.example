# =============================================================================
# .env.example - Salin jadi `.env`, lalu isi sesuai cluster tujuan.
#   cp .env.example .env
#
# `.env` di-gitignore (pola .env.* di root repo sudah mencakup folder ini).
# Berbeda dari template Cloud Deploy di root: di sini TIDAK ada mirror
# Nexus->Artifact Registry maupun tarik secret dari Vault. Image dianggap
# sudah ada di registry, dan Secret aplikasi (bila dipakai) dianggap sudah
# dibuat di cluster lewat jalur lain (mis. kubectl apply manual atau ESO).
# =============================================================================

# ---------- Identitas gcloud (opsional) ----------
# Jalankan release.sh sebagai service account, bukan akun perorangan.
# Kosongkan untuk memakai akun aktif `gcloud config get-value account`.
# Prasyarat: pemanggil punya roles/iam.serviceAccountTokenCreator pada SA ini.
IMPERSONATE_SA=

# ---------- Cluster tujuan (WAJIB) ----------
REGION=asia-southeast2
PROJECT=ddb-kubecluster-dev-01
CLUSTER=gc-ddb-dev-gke-cluster-01

# Namespace tempat release Helm dipasang. Dibuat otomatis bila belum ada.
NAMESPACE=default

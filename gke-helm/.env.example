# =============================================================================
# .env.example - Salin jadi `.env`, lalu isi sesuai cluster tujuan.
#   cp .env.example .env
#
# `.env` di-gitignore (pola .env.* di root repo sudah mencakup folder ini).
# Berbeda dari template Cloud Deploy di root: di sini TIDAK ada mirror
# Nexus->Artifact Registry, dan TIDAK ada secret aplikasi dari Vault. Image
# dianggap sudah ada di registry, dan Secret aplikasi (bila dipakai) dianggap
# sudah dibuat di cluster lewat jalur lain (mis. kubectl apply manual atau ESO).
#
# Satu pengecualian: isi VAULT_NEXUS_PATH di bawah untuk pull image LANGSUNG
# dari Nexus (kredensial dari Vault) — lihat README bagian 'Pull langsung
# dari Nexus'.
# =============================================================================

# ---------- Identitas gcloud (opsional) ----------
# Jalankan release.sh sebagai service account, bukan akun perorangan.
# Kosongkan untuk memakai akun aktif `gcloud config get-value account`.
# Prasyarat: pemanggil punya roles/iam.serviceAccountTokenCreator pada SA ini.
IMPERSONATE_SA=

# ---------- Cluster tujuan (WAJIB) ----------
REGION=asia-southeast2
PROJECT=ddb-kubecluster-dev-01
CLUSTER=gc-ddb-dev-gke-cluster-01

# Namespace tempat release Helm dipasang. Dibuat otomatis bila belum ada.
NAMESPACE=default

# ---------- Pull langsung dari Nexus lewat Vault (opsional) ----------
# Kosongkan VAULT_NEXUS_PATH untuk menonaktifkan — ini nilai default, cocok
# untuk channel ini yang mengasumsikan image sudah di Artifact Registry/GCR.
#
# Isi untuk mengaktifkan: release.sh akan membaca kredensial Nexus dari Vault
# lalu membuat/refresh Secret docker-registry di NAMESPACE di atas secara
# otomatis tiap rilis. Perlu argumen ke-2 (image) menunjuk ke NEXUS_HOST juga.
NEXUS_HOST=new-nexus.gcp.bri.co.id
VAULT_ADDR=https://vault.ddb.bri.co.id
VAULT_NEXUS_PATH=bribrain/data/development/ms-bribrain-demo-apps
# Key di dalam secret itu bernama NEXUS_USER & NEXUS_PASS — default ini cocok
# tanpa konfigurasi tambahan. Uncomment hanya bila nama key-nya berbeda.
# VAULT_NEXUS_USER_KEY=NEXUS_USER
# VAULT_NEXUS_PASS_KEY=NEXUS_PASS

# VAULT_TOKEN SENGAJA TIDAK ADA DI SINI.
# Suplai lewat secret variable CI agar tidak pernah menyentuh disk runner:
#   export VAULT_TOKEN=...
